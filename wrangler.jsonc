{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cellbound-kelas",
  "main": "src/worker.js",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["GameServer"]
    }
  ]
}
